      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_blks_hit{datname=\"greenops_db\"}[5m]) / (rate(pg_stat_database_blks_hit{datname=\"greenops_db\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"greenops_db\"}[5m]) + 0.001) * 100",
          "legendFormat": "Cache Hit",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Ratio (%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
